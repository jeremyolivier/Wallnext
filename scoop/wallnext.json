{
  "version": "",
  "description": "Automatically set desktop wallpapers from various sources, refreshed on a schedule.",
  "homepage": "https://github.com/jeremyolivier/wallnext",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "",
      "hash": ""
    }
  },
  "extract_dir": "main.dist",
  "bin": "wallnext.exe",
  "shortcuts": [
    [
      "wallnext.exe",
      "Wallnext"
    ]
  ],
  "uninstaller": {
    "script": [
      "if ($cmd -eq 'uninstall') { Unregister-ScheduledTask -TaskName wallnext -Confirm:$false -ErrorAction SilentlyContinue }"
    ]
  },
  "notes": [
    "Open Wallnext from the Start menu to pick sources and turn on automatic changes.",
    "Config and logs live in %APPDATA%\\wallnext\\."
  ]
}
